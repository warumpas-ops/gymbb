<?xml version="1.0" encoding="utf-8"?>
<!-- activity_add_exercise_to_plan.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0F11">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[cancel]"
            android:textColor="#555A64"
            android:textSize="13sp"
            android:typeface="monospace"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="add exercise"
            android:textColor="#E0E2E6"
            android:textSize="16sp"
            android:typeface="monospace"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[add]"
            android:textColor="#A8D8A8"
            android:textSize="13sp"
            android:typeface="monospace"
            android:padding="4dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2126"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Exercise name input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="exercise name"
                android:textColor="#555A64"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_marginBottom="4dp"/>

            <AutoCompleteTextView
                android:id="@+id/etExerciseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E2E6"
                android:textColorHint="#555A64"
                android:hint="e.g. bench press, pull-ups..."
                android:textSize="15sp"
                android:typeface="monospace"
                android:background="#1A1C20"
                android:padding="10dp"
                android:inputType="textCapSentences"
                android:singleLine="true"/>

            <!-- Muscle group input (optional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="muscle group (optional)"
                android:textColor="#555A64"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etMuscleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E2E6"
                android:textColorHint="#555A64"
                android:hint="e.g. chest, back, legs..."
                android:textSize="14sp"
                android:typeface="monospace"
                android:background="#1A1C20"
                android:padding="10dp"
                android:inputType="textCapSentences"
                android:singleLine="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2126"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <!-- Sets -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="sets"
                android:textColor="#555A64"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etSets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E2E6"
                android:text="3"
                android:textSize="15sp"
                android:typeface="monospace"
                android:background="#1A1C20"
                android:padding="10dp"
                android:inputType="number"
                android:singleLine="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2126"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <!-- Reps -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="reps"
                android:textColor="#555A64"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etReps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E2E6"
                android:text="10"
                android:textSize="15sp"
                android:typeface="monospace"
                android:background="#1A1C20"
                android:padding="10dp"
                android:inputType="number"
                android:singleLine="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2126"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <!-- Weight -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="weight in kg (0 for bodyweight)"
                android:textColor="#555A64"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E2E6"
                android:text="0"
                android:textSize="15sp"
                android:typeface="monospace"
                android:background="#1A1C20"
                android:padding="10dp"
                android:inputType="numberDecimal"
                android:singleLine="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2126"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <!-- Rest -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="rest in seconds"
                android:textColor="#555A64"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etRest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E2E6"
                android:text="60"
                android:textSize="15sp"
                android:typeface="monospace"
                android:background="#1A1C20"
                android:padding="10dp"
                android:inputType="number"
                android:singleLine="true"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
